import torch
import numpy as np
import time

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

torch_rand1 = torch.rand(100, 100, 100, 100, device=device)
torch_rand2 = torch.rand(100, 100, 100, 100, device=device)

np_rand1 = np.random.rand(100, 100, 100, 100).astype(np.float32)
np_rand2 = np.random.rand(100, 100, 100, 100).astype(np.float32)

# PyTorch
if device.type == "cuda":
    torch.cuda.synchronize()

start_time = time.time()
rand = torch.matmul(torch_rand1, torch_rand2)

if device.type == "cuda":
    torch.cuda.synchronize()

print(f"PyTorch: {time.time() - start_time:.8f} seconds")

# NumPy
start_time = time.time()
rand = np.matmul(np_rand1, np_rand2)
print(f"NumPy:   {time.time() - start_time:.8f} seconds")
